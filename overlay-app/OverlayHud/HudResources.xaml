<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:OverlayHud.Services">
    <FontFamily x:Key="HudFont">Segoe UI Semibold</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <DropShadowEffect x:Key="MinimalistItemStroke"
                      Color="#FF000000"
                      BlurRadius="1.2"
                      ShadowDepth="0"
                      Opacity="1" />

    <!-- The black-and-white outline, pulsing. Deliberately ONE shared brush animated once at
         startup (see MainWindow.StartBlackAndWhitePulse) rather than a per-card storyboard:
         the card list is rebuilt on every poll, so an animation owned by a card would be
         thrown away and restarted five times a second and never visibly move. Sharing it
         also keeps every black-and-white card pulsing in step, which reads as one alarm
         instead of several. -->
    <!-- The held slot. Green, the way vanilla marks the weapon in your hands, and carried
         by the slot's frame rather than its art so an icon's own colours are untouched. -->
    <SolidColorBrush x:Key="HeldSlotBorderBrush" Color="#FF6BE86B" />
    <SolidColorBrush x:Key="HeldSlotBackgroundBrush" Color="#B4112B14" />

    <SolidColorBrush x:Key="BwPulseBrush" Color="#FF6060" />
    <SolidColorBrush x:Key="MonochromePulseBrush" Color="#FFFFFFFF" />

    <!-- One carried item. An empty slot draws as a dim outline. -->
    <DataTemplate x:Key="ChipTemplate">
        <Border Width="30" Height="22" Margin="2,0,0,0"
                CornerRadius="2"
                Background="{Binding Background}"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Opacity="{Binding Opacity}"
                ToolTip="{Binding Label}">
            <Image Width="26" Height="20"
                   Source="{Binding Icon}"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        </Border>
    </DataTemplate>

    <!-- Minimalist keeps all three slots in a compact top row. The item column is Auto,
         so a long survivor name gives up width and trims instead of hiding the items. The
         icon has no slot box; the zero-depth shadow supplies only a black edge. -->
    <DataTemplate x:Key="MinimalistChipTemplate">
        <Image Width="18" Height="14" Margin="1,0,0,0"
               Source="{Binding Icon}"
               Stretch="Uniform"
               SnapsToDevicePixels="True"
               UseLayoutRounding="True"
               Opacity="{Binding Opacity}"
               Effect="{StaticResource MinimalistItemStroke}"
               ToolTip="{Binding Label}" />
    </DataTemplate>

    <!-- One carried-item slot of the weapon HUD. Larger than the card chip because this
         panel is read from the corner of the eye mid-fight, and an empty slot still draws
         its box: vanilla keeps three fixed places, so "no pills" is read from an empty
         slot rather than from a missing one. -->
    <DataTemplate x:Key="WeaponItemTemplate">
        <Border Width="40" Height="30" Margin="{Binding SlotMargin}"
                CornerRadius="3"
                ToolTip="{Binding Label}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#8C05070A" />
                    <Setter Property="BorderBrush" Value="#40FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Background"
                                    Value="{StaticResource HeldSlotBackgroundBrush}" />
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource HeldSlotBorderBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Image Width="32" Height="24"
                   Source="{Binding Icon}"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True"
                   Opacity="{Binding Opacity}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
        </Border>
    </DataTemplate>

    <!-- One slot of the weapon HUD: the weapon's silhouette with its ammunition beside
         it, in the vanilla reading order - magazine large, reserve underneath it. Melee
         carries no ammunition and gets the whole slot for its shape.

         The silhouette is geometry from WeaponIcons.xaml, stretched uniformly inside a
         fixed box, so a pistol stays visibly smaller than a rifle instead of every weapon
         being scaled up to fill its slot. An embedded PNG wins when one exists for that
         weapon id, and the short text label is the last resort. -->
    <DataTemplate x:Key="WeaponSlotTemplate">
        <Border Width="132" Height="52"
                Margin="{Binding SlotMargin}"
                CornerRadius="3"
                ToolTip="{Binding Label}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#8C05070A" />
                    <Setter Property="BorderBrush" Value="#40FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Background"
                                    Value="{StaticResource HeldSlotBackgroundBrush}" />
                            <Setter Property="BorderBrush"
                                    Value="{StaticResource HeldSlotBorderBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="7,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasAmmo,
                                         Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ClipText}"
                                   FontFamily="{StaticResource HudFont}"
                                   FontSize="21"
                                   Foreground="#FFFFFF" />
                        <!-- What kind of rounds are loaded, beside the count the way vanilla
                             puts a single cartridge there. It changes to a flame or a burst
                             while an upgrade is in the magazine and back when it runs out. -->
                        <Path Data="{Binding AmmoGlyph}"
                              Fill="{Binding AmmoGlyphBrush}"
                              Stretch="Uniform"
                              Width="9" Height="15"
                              Margin="4,2,0,0"
                              VerticalAlignment="Center"
                              Visibility="{Binding HasAmmoGlyph,
                                           Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ReserveText}"
                               Margin="1,-3,0,0"
                               FontFamily="{StaticResource HudFont}"
                               FontSize="12"
                               Foreground="#9FB0C0"
                               Visibility="{Binding HasReserve,
                                            Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <Grid Grid.Column="1" Margin="6,0,0,0">
                    <Path Data="{Binding Silhouette}"
                          Fill="#F2F2F2"
                          Stretch="Uniform"
                          MaxWidth="{Binding ArtWidth}"
                          MaxHeight="38"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Visibility="{Binding ShowsSilhouette,
                                       Converter={StaticResource BoolToVisibility}}" />
                    <Image Source="{Binding Icon}"
                           Stretch="Uniform"
                           MaxWidth="{Binding ArtWidth}"
                           MaxHeight="38"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasIcon,
                                        Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ShortText}"
                               FontFamily="{StaticResource HudFont}"
                               FontSize="14"
                               Foreground="#E6ECF2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Visibility="{Binding ShowsText,
                                            Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="MinimalistSegmentTemplate">
        <Grid Width="48.5" Height="4" Margin="0,0,3.5,0">
            <Border Background="#FF3A3D41" />
            <Rectangle HorizontalAlignment="Left"
                       Width="{Binding TotalFillWidth}"
                       Fill="{Binding TotalFill}" />
            <Rectangle HorizontalAlignment="Left"
                       Width="{Binding PermanentFillWidth}"
                       Fill="{Binding PermanentFill}" />
        </Grid>
    </DataTemplate>

    <!-- Shared by the live overlay and the customization preview. -->
    <DataTemplate x:Key="SurvivorTemplate">
        <Border Margin="0,0,0,4"
                Padding="8,5"
                CornerRadius="3"
                Background="#B4101216"
                Opacity="{Binding CardOpacity}">
            <!-- BorderBrush lives in the style, not on the element: a local value here would
                 win over the trigger and the pulse would never show. -->
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#33FFFFFF" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBlackAndWhite}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BwPulseBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Name}"
                               FontFamily="{StaticResource HudFont}"
                               FontSize="13"
                               Foreground="#F2F2F2"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal">
                        <!-- FOLLOW for a hand-picked follower, REINFORCE for a help! reinforcement.
                             The follow badge is dropped in followers-only mode
                             every card would carry it and it would say nothing. -->
                        <TextBlock Text="{Binding MarkerText}"
                                   Margin="0,0,6,0"
                                   FontFamily="{StaticResource HudFont}"
                                   FontSize="10"
                                   Foreground="{Binding MarkerBrush}"
                                   Visibility="{Binding HasMarker,
                                                Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding StateText}"
                                   FontFamily="{StaticResource HudFont}"
                                   FontSize="10"
                                   Foreground="{Binding StateBrush}"
                                   Visibility="{Binding HasState,
                                                Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Width="190" Height="16" VerticalAlignment="Center">
                    <Border Background="#66000000" CornerRadius="2" />
                    <!-- Temp health. Drawn full width and then covered by the permanent bar,
                         so what shows is the buffer past current health. The brush carries
                         its own alpha - no Opacity here, or it is knocked back twice and
                         goes grey against the dark bar again. -->
                    <Rectangle HorizontalAlignment="Left"
                               Width="{Binding TotalWidth}"
                               Fill="{Binding TempBrush}"
                               RadiusX="2" RadiusY="2" />
                    <Rectangle HorizontalAlignment="Left"
                               Width="{Binding PermanentWidth}"
                               Fill="{Binding HealthBrush}"
                               RadiusX="2" RadiusY="2" />
                    <TextBlock Text="{Binding HealthText}"
                               FontFamily="{StaticResource HudFont}"
                               FontSize="11"
                               Foreground="#FFFFFF"
                               Visibility="{Binding ShowHealthNumbers,
                                            Converter={StaticResource BoolToVisibility}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <ItemsControl Grid.Column="2"
                              ItemsSource="{Binding ItemSlots}"
                              VerticalAlignment="Center" Margin="10,0,0,0"
                              ItemTemplate="{StaticResource ChipTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- The consistent HUD is a row-major grid, not a framed scoreboard. It keeps the same
         survivor-card values and item order, but removes the roster header and outer panel so
         it reads as a persistent in-game HUD. The player's own card leaves its items to the
         weapon HUD, which draws them larger beside their ammunition. -->
    <DataTemplate x:Key="ConsistentSurvivorTemplate">
        <Border Margin="{Binding RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}},
                                Path=Tag}"
                Padding="6,4"
                CornerRadius="2"
                Background="#8505070A"
                Opacity="{Binding CardOpacity}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#38FFFFFF" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBlackAndWhite}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BwPulseBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMonochrome}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource MonochromePulseBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Name}"
                               FontFamily="{StaticResource HudFont}"
                               FontSize="12"
                               Foreground="#F2F2F2"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding MarkerText}"
                                   Margin="0,0,5,0"
                                   FontFamily="{StaticResource HudFont}"
                                   FontSize="9"
                                   Foreground="{Binding MarkerBrush}"
                                   Visibility="{Binding HasMarker,
                                                Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding StateText}"
                                   FontFamily="{StaticResource HudFont}"
                                   FontSize="9"
                                   Foreground="{Binding StateBrush}"
                                   Visibility="{Binding HasState,
                                                Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Width="190" Height="16" VerticalAlignment="Center">
                    <Border Background="#66000000" CornerRadius="2" />
                    <Rectangle HorizontalAlignment="Left"
                               Width="{Binding TotalWidth}"
                               Fill="{Binding TempBrush}"
                               RadiusX="2" RadiusY="2" />
                    <Rectangle HorizontalAlignment="Left"
                               Width="{Binding PermanentWidth}"
                               Fill="{Binding HealthBrush}"
                               RadiusX="2" RadiusY="2" />
                    <TextBlock Text="{Binding HealthText}"
                               FontFamily="{StaticResource HudFont}"
                               FontSize="10"
                               Foreground="{Binding BasicHealthNumberBrush}"
                               Visibility="{Binding ShowHealthNumbers,
                                            Converter={StaticResource BoolToVisibility}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <ItemsControl Grid.Column="2"
                              ItemsSource="{Binding ConsistentItemSlots}"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0"
                              ItemTemplate="{StaticResource ChipTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- A compact health strip: the name, item icons, and health value sit above the bar.
         The item slots keep their own Auto column and remain visible when the name is longer
         than the card. The player's own card draws none - their items are on the weapon HUD,
         beside their ammunition, the way vanilla keeps them. -->
    <DataTemplate x:Key="ConsistentMinimalistTemplate">
        <Border Margin="{Binding RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}},
                                Path=Tag}"
                MinWidth="260"
                Padding="0,2,0,0"
                Background="Transparent"
                Opacity="{Binding CardOpacity}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBlackAndWhite}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource BwPulseBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMonochrome}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource MonochromePulseBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MinHeight="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" MinWidth="0" Margin="0,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   FontFamily="{StaticResource HudFont}"
                                   FontSize="11"
                                   Foreground="#F2F2F2"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding MarkerText}"
                                   Margin="4,0,0,0"
                                   FontFamily="{StaticResource HudFont}"
                                   FontSize="8"
                                   Foreground="{Binding MarkerBrush}"
                                   Visibility="{Binding HasMarker,
                                                Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding StateText}"
                                   Margin="4,0,0,0"
                                   FontFamily="{StaticResource HudFont}"
                                   FontSize="8"
                                   Foreground="{Binding StateBrush}"
                                   Visibility="{Binding HasState,
                                                Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding ConsistentItemSlots}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"
                                  ItemTemplate="{StaticResource MinimalistChipTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Grid.Column="2"
                               Text="{Binding HealthText}"
                               Margin="4,0,0,0"
                               FontFamily="{StaticResource HudFont}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               Visibility="{Binding ShowHealthNumbers,
                                            Converter={StaticResource BoolToVisibility}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <ItemsControl Grid.Row="1"
                              Width="260"
                              Height="4"
                              ItemsSource="{Binding MinimalistSegments}"
                              ItemTemplate="{StaticResource MinimalistSegmentTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

            </Grid>
        </Border>
    </DataTemplate>

    <services:ConsistentHudTemplateSelector x:Key="ConsistentHudTemplateSelector"
                                            BasicTemplate="{StaticResource ConsistentSurvivorTemplate}"
                                            MinimalistTemplate="{StaticResource ConsistentMinimalistTemplate}" />
</ResourceDictionary>
