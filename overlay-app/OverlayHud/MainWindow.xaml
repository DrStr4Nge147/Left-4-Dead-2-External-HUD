<Window x:Class="OverlayHud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Left 4 Dead 2 Customized Overlay HUD - External"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False">

    <Grid x:Name="Root">
        <!-- Live-preview guides. These stand in for the vanilla scoreboard region while the
             editor is open: L4D2 only draws its own scoreboard while it holds input focus,
             which it cannot do while the editor has it. Collapsed at all other times. -->
        <Canvas x:Name="Guides" Visibility="Collapsed">
            <Rectangle x:Name="GuideScoreboard" Canvas.Left="0" Canvas.Top="0"
                       Fill="#3D6A624F" Stroke="#557E7460" StrokeThickness="1"
                       Visibility="Collapsed" />
            <TextBlock x:Name="GuideScoreboardLabel"
                       Text="VANILLA SCOREBOARD AREA"
                       FontFamily="{StaticResource HudFont}" FontSize="11"
                       Foreground="#AAFFFFFF"
                       Visibility="Collapsed" />
            <Rectangle x:Name="GuideReserve" Canvas.Left="0"
                       Fill="#33514535" />
            <Line x:Name="GuideSidebar" Stroke="#CCE0A830" StrokeThickness="1"
                  StrokeDashArray="6 4" />
            <Line x:Name="GuideTop" Stroke="#CCE0A830" StrokeThickness="1"
                  StrokeDashArray="6 4" />
            <TextBlock x:Name="GuideSidebarLabel"
                       Text="SIDEBAR EDGE"
                       FontFamily="{StaticResource HudFont}" FontSize="11"
                       Foreground="#E0A830" />
            <TextBlock x:Name="GuideTopLabel"
                       Text="VERTICAL START"
                       FontFamily="{StaticResource HudFont}" FontSize="11"
                       Foreground="#E0A830" />
        </Canvas>

        <!-- Always-visible confirmation while L4D2 is focused but no round is actively
             exporting, and directly under it the reason. Kept out of the Tab-controlled
             survivor panel: that panel is a roster, and it is also the thing that goes
             missing when something is wrong, which makes it the worst place for the
             explanation. -->
        <StackPanel x:Name="StatusStack"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
            <StackPanel.LayoutTransform>
                <ScaleTransform x:Name="MenuBadgeScale" ScaleX="1" ScaleY="1" />
            </StackPanel.LayoutTransform>

            <Border x:Name="MenuBadge"
                    HorizontalAlignment="Right"
                    Padding="10,6"
                    CornerRadius="3"
                    Background="#A005070A"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock x:Name="MenuBadgeText"
                           Text="Left 4 Dead 2 Customized Overlay HUD - External"
                           FontFamily="{StaticResource HudFont}"
                           FontSize="11"
                           Foreground="#CCFFFFFF" />
            </Border>

            <Border x:Name="Notice"
                    HorizontalAlignment="Right"
                    Margin="0,4,0,0"
                    Padding="10,6"
                    CornerRadius="3"
                    Background="#A005070A"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="NoticeTitle"
                               HorizontalAlignment="Right"
                               FontFamily="{StaticResource HudFont}"
                               FontSize="12"
                               Foreground="#E0A830" />
                    <TextBlock x:Name="NoticeBody"
                               Margin="0,3,0,0"
                               MaxWidth="360"
                               TextAlignment="Right"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource HudFont}"
                               FontSize="11"
                               LineHeight="16"
                               Foreground="#CCFFFFFF" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border x:Name="Panel"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="10,8"
                CornerRadius="4"
                Background="#8C05070A"
                BorderBrush="#40FFFFFF"
                BorderThickness="1">
            <!-- LayoutTransform, not RenderTransform: scaling has to affect layout or the
                 panel stops lining up with its anchor. -->
            <Border.LayoutTransform>
                <ScaleTransform x:Name="PanelScale" ScaleX="1" ScaleY="1" />
            </Border.LayoutTransform>

            <StackPanel>
                <DockPanel Margin="2,0,2,6">
                    <TextBlock x:Name="HeaderText"
                               DockPanel.Dock="Left"
                               Text="SURVIVORS"
                               Margin="0,0,24,0"
                               FontFamily="{StaticResource HudFont}"
                               FontSize="11"
                               Foreground="#99FFFFFF" />
                    <TextBlock x:Name="StatusText"
                               DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               Text=""
                               TextTrimming="CharacterEllipsis"
                               FontFamily="{StaticResource HudFont}"
                               FontSize="11"
                               Foreground="#E0A830" />
                </DockPanel>

                <ItemsControl x:Name="Columns">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}"
                                          Margin="0,0,8,0"
                                          ItemTemplate="{StaticResource SurvivorTemplate}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
