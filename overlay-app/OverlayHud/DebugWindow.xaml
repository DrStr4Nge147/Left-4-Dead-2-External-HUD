<Window x:Class="OverlayHud.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Debug console"
        Width="920" Height="620"
        MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#111419"
        Foreground="#F0F2F5"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="88" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Debug console" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Live state on the left, events as they happen below. Closing this window turns the console off."
                       Foreground="#AAB2BE" FontSize="12" Margin="0,2,0,0" />
        </StackPanel>

        <!-- The answer to "is it actually working" is a handful of current values, not a log
             to read backwards. They are refreshed on a timer; the log underneath is the
             history of how they got that way. -->
        <Border Grid.Row="1" Margin="0,12,0,10" Padding="12,10"
                Background="#20252D" BorderBrush="#343B46" BorderThickness="1"
                CornerRadius="6">
            <TextBlock x:Name="SummaryText"
                       FontFamily="Consolas" FontSize="12" LineHeight="18"
                       Foreground="#BFD9F2" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Background="#090B0E" BorderBrush="#343B46"
                BorderThickness="1" CornerRadius="6" Padding="2">
            <TextBox x:Name="LogText"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     Background="Transparent"
                     Foreground="#D4DAE3"
                     BorderThickness="0"
                     FontFamily="Consolas" FontSize="12"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="FollowCheckBox" IsChecked="True" Foreground="#F0F2F5">
                    <TextBlock Text="Follow new lines" Foreground="#F0F2F5" />
                </CheckBox>
                <TextBlock x:Name="SaveStatus" Margin="16,0,0,0"
                           Foreground="#F1B85B" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Copy all" Click="OnCopyClick" />
                <Button Content="Save to file" Click="OnSaveClick" />
                <Button Content="Clear" Click="OnClearClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
